# The sidecar of docling-mcp (FTR.NAB.CMN-0006 arch §7.2): lets through a request with the key.
# The key is checked without map: the string "Bearer <64 hex>" is longer than the default hash bucket of map (64).
server {
  listen 8080;
  # The request log shows 401 refusals; the default format has no headers
  # of a request, so the key does not reach the log.
  access_log /dev/stdout;
  location = /healthz { access_log off; return 200 "ok\n"; }
  location / {
    if ($http_authorization != "Bearer ${MCP_KEY}") { return 401; }
    proxy_pass http://127.0.0.1:8000;
    proxy_http_version 1.1;
    proxy_set_header Host 127.0.0.1:8000;
    proxy_set_header Authorization "";
    proxy_buffering off;
    proxy_read_timeout 600s;
    client_max_body_size 8m;
  }
}
