# Addresses of the company systems for the local run (docker-compose.yml, FTR.INFRA.MCPS-0002 R14).
# Copy to .env; the file holds no credentials — a client sends the login and password of a user (or a
# token of the system) with every request, and the servers store nothing. .env is not committed.

# ---------- SQL ----------

# Greenplum (profile greenplum): the master of the cluster and the database.
GP_HOST=
GP_PORT=5432
GP_DB=citydrive_db
# prefer | require | verify-ca | verify-full; the last two need ca.crt inside the container
GP_SSLMODE=prefer
GP_CA_CERT=
GP_LIMIT_SECONDS=30
GP_LIMIT_ROWS=10000

# ClickHouse (profile clickhouse): the HTTP interface of the cluster.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_SECURE=true
CLICKHOUSE_VERIFY=true
CLICKHOUSE_LIMIT_SECONDS=30
CLICKHOUSE_LIMIT_ROWS=10000

# ---------- systems ----------

# GitLab (profile gitlab): the address of the instance, the API path is added by the server.
GITLAB_URL=
GITLAB_HOST=

# Jira and Confluence (profiles jira, confluence): the address of the system and its host for the
# allowlist of the upstream. The token of a user comes with the request.
JIRA_URL=
JIRA_HOST=
JIRA_SSL_VERIFY=true
CONFLUENCE_URL=
CONFLUENCE_HOST=
CONFLUENCE_SSL_VERIFY=true

# ---------- documents (profile docgen) ----------

# The key of the item: empty locally, Nabu puts its own on the stand.
DOCGEN_KEY=
DOCGEN_MAX_INLINE_MB=4
DOCGEN_MAX_SOURCE_MB=25
DOCGEN_MAX_RESULT_MB=50
DOCGEN_TIMEOUT_SECONDS=120
DOCGEN_MAX_PAGES=500

# ---------- conversion (profile docling) ----------

DOCLING_OCR_LANG=ru,en

# ---------- mail (profile yandex-mail) ----------

IMAP_HOST=imap.yandex.com
IMAP_WEB_LINK=https://mail.yandex.ru/?uid={uid}#/search?request={subject}

# ---------- search (profile search) ----------

# The platform key authenticates the caller and the DeepSeek key pays the vendor (FTR.INFRA.MCPS-0003 R2, R2a):
# both empty locally, the port is loopback only; without the platform key /mcp answers 401.
SEARCH_KEY=
DEEPSEEK_KEY=
SEARCH_URL=https://api.deepseek.com
# Limits of one call: the timeout, the cut of a page body and the retries on 429/5xx.
SEARCH_TIMEOUT_SECONDS=30
SEARCH_MAX_CONTENT_BYTES=102400
SEARCH_RETRIES=2
