# Versions of the images of MCP servers and of build tools. Tags of our own images
# repeat in charts/mcp-servers/values.yaml, and tests/manifests.sh checks that they match.
K8S_VERSION=v1.37.0
HELM_VERSION=v3.22.0
HELM_SHA256=1e4ab49e429626cf6c6958d914248b78c9730803c2751b87627e171dc800e7bb
# The registry of built images (images/).
MCP_IMAGE_REGISTRY=ghcr.io/greenongrey
# The image scanner at their build (images/publish.sh).
TRIVY_IMAGE=aquasec/trivy:0.75.0
DOCLING_SERVE_IMAGE=quay.io/docling-project/docling-serve-cpu:v1.37.0
# The version of the PyPI package, also the tag of the image ghcr.io/greenongrey/docling-mcp
# (images/, built at a release).
DOCLING_MCP_VERSION=3.3.0
# Our own read-only IMAP server (images/imap-mcp): the version is the tag of the image.
IMAP_MCP_VERSION=0.2.2
# Documents (FTR.NAB.CHAT-0003, images/docgen-mcp and images/doc-convert): versions are tags of images.
DOCGEN_MCP_VERSION=0.1.3
DOC_CONVERT_VERSION=0.1.0
# Gotenberg, on top of which doc-convert is built.
GOTENBERG_IMAGE=gotenberg/gotenberg:8.38.1
MCP_SEARXNG_IMAGE=isokoliuk/mcp-searxng:2.6.0
SEARXNG_IMAGE=searxng/searxng:2026.10.11-ad46ebd7d
MCP_PROXY_IMAGE=nginxinc/nginx-unprivileged:1.31-alpine
PROBE_CURL_IMAGE=curlimages/curl:8.22.0
