# Версии образов MCP-серверов и инструментов сборки. Теги собственных образов
# повторяются в charts/mcp-servers/values.yaml: tests/manifests.sh проверяет, что они совпадают.
K8S_VERSION=v1.37.0
HELM_VERSION=v3.22.0
HELM_SHA256=1e4ab49e429626cf6c6958d914248b78c9730803c2751b87627e171dc800e7bb
# Реестр собранных образов (images/).
MCP_IMAGE_REGISTRY=ghcr.io/greenongrey
# Сканер образов при их сборке (images/publish.sh).
TRIVY_IMAGE=aquasec/trivy:0.75.0
DOCLING_SERVE_IMAGE=quay.io/docling-project/docling-serve-cpu:v1.37.0
# Версия пакета PyPI — она же тег образа ghcr.io/greenongrey/docling-mcp
# (images/, собирается при релизе).
DOCLING_MCP_VERSION=3.3.0
# Собственный сервер IMAP только для чтения (images/imap-mcp): версия — тег образа.
IMAP_MCP_VERSION=0.2.2
# Документы (FTR.NAB.CHAT-0003, images/docgen-mcp и images/doc-convert): версии — теги образов.
DOCGEN_MCP_VERSION=0.1.3
DOC_CONVERT_VERSION=0.1.0
# Gotenberg, поверх которого собирается doc-convert.
GOTENBERG_IMAGE=gotenberg/gotenberg:8.38.1
MCP_SEARXNG_IMAGE=isokoliuk/mcp-searxng:2.6.0
SEARXNG_IMAGE=searxng/searxng:2026.10.11-ad46ebd7d
MCP_PROXY_IMAGE=nginxinc/nginx-unprivileged:1.31-alpine
PROBE_CURL_IMAGE=curlimages/curl:8.22.0
